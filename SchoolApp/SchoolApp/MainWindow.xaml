<Window x:Class="SchoolApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Principal Window" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <TabControl x:Name="tabControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Staff" Tag="Staff">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Staff" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="staffGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Staff Role" Tag="Staff_Roles">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Staff Role" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="staffRolesGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Study Years" Tag="StudyYears">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Study Years" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="studyYearsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Students" Tag="Students">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Students" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="studentsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Classrooms" Tag="Classrooms">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Classrooms" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="classroomsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Courses" Tag="Courses">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Coursesf" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="coursesGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Timetable" Tag="Timetable">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Timetable" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="timetableGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Report Cards" Tag="ReportCards">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Report Cards" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="reportCardsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Assessments" Tag="Assessments">
                <Grid>
                    <Button Content="Save Change" HorizontalAlignment="Right" Margin="0,17,10,0" VerticalAlignment="Top" Width="103" ButtonBase.Click="SaveChange_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Assessments" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="assessmentsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Statistics">
                <Grid>
                    <Button Content="Select1: 100% in Math and Failed in Arabic" HorizontalAlignment="Right" Margin="0,16,365,0" VerticalAlignment="Top" Width="232" Click="Select1_Click"/>
                    <Button Content="Select2: Multiple Teachers' Cources" HorizontalAlignment="Right" Margin="0,16,163,0" VerticalAlignment="Top" Width="197" Click="Select2_Click"/>
                    <Button Content="Select3: Top Students" HorizontalAlignment="Right" Margin="0,16,10,0" VerticalAlignment="Top" Width="148" ButtonBase.Click="Select3_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Statistics" VerticalAlignment="Top" FontSize="24"/>
                    <DataGrid x:Name="statisticGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,47,10,10" AutoGenerateColumns="True" EnableRowVirtualization="True"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
